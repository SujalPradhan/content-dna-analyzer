\u0bcd\u0b95\u0bc1 \u0b95\u0bc7\u0bb0\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0b95\u0bc1\u0b9f\u0bc8 \u0bae\u0bbf\u0bb2\u0bb9\u0bbe\u0bae\u0bcb \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b8e\u0bb0\u0bcd\u0b95\u0bb3\u0bcd"}, {"s": 110.74, "e": 112.94, "text": "\u0b8e\u0baa\u0bcd\u0baa\u0b9f\u0bbf \u0b87\u0ba4\u0bc1 \u0bb0\u0bc6\u0ba3\u0bcd\u0b9f\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b9a\u0bc7\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb2\u0ba9\u0bcd"}, {"s": 116.36, "e": 117.12, "text": "\u0b87\u0ba8\u0bcd\u0ba4 \u0bae\u0bbe\u0ba4\u0bbf\u0bb0\u0bbf \u0b95\u0bc7\u0bb0\u0bae\u0bc1\u0bae\u0bcd \u0ba8\u0b9f\u0ba4\u0bcd\u0ba4\u0bc1\u0b99\u0bcd\u0b95"}, {"s": 117.12, "e": 117.12, "text": ""}, {"s": 117.12, "e": 120.54, "text": "\u0b9a\u0bc7\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0bcd\u0b9f\u0bc1, \u0b87\u0ba4\u0bc1 \u0b87\u0ba3\u0bcd\u0ba3 \u0b95\u0bca\u0b9e\u0bcd\u0b9a\u0bae\u0bcd \u0ba8\u0bbe\u0bb0\u0b9f \u0bb5\u0bc7\u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd"}, {"s": 125.46, "e": 127.06, "text": "\u0b95\u0bbe\u0baf\u0bcd \u0bb5\u0bc6\u0ba8\u0bcd\u0ba4\u0ba4\u0bc1\u0b95\u0bcd\u0b95 \u0baa\u0bcd\u0bb0\u0bae\u0bcd\u0bae\u0bbe Nelson"}, {"s": 127.06, "e": 129.32, "text": "\u0b87\u0ba4\u0bb2\u0bcd \u0bb5\u0ba8\u0bcd\u0ba4\u0bc1 \u0b85\u0bb0\u0bc8 \u0b9f\u0bc0\u0bb8\u0bcd\u0baa\u0bc2\u0ba9\u0bcd \u0b95\u0bb1\u0bcd\u0bae \u0bae\u0b9a\u0bbe\u0bb2\u0bbe"}, {"s": 136.42, "e": 138.24, "text": "\u0b95\u0bc2\u0b9f\u0bae\u0bc7, \u0b95\u0bbe\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0b95 \u0b87\u0bb0\u0ba3\u0bcd\u0ba3\u0bcd\u0b9f\u0bc1"}, {"s": 152.86, "e": 157.2, "text": "\u0b87\u0baa\u0bcd\u0baa\u0bcb \u0b87\u0ba4\u0bc1\u0bb2 \u0ba8\u0bae\u0bcd\u0bae \u0bb5\u0bc7\u0b95\u0bc8 \u0bb5\u0b9a\u0bcd\u0b9a\u0bbf\u0bb0\u0bcd\u0b95\u0bcd\u0b95 \u0baa\u0bbe\u0bb8\u0bcd\u0ba4\u0bbe\u0baf\u0bc1\u0bae\u0bcd"}, {"s": 158.58, "e": 159.9, "text": "\u0bae\u0bae\u0bcd\u0bae\u0bc1 \u0ba8\u0bbe\u0ba9\u0bcd \u0b95\u0bbf\u0b9f\u0ba3\u0bcd\u0b9f\u0bc1, \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bbe\u0b95\u0bcd\u0b95\u0ba3\u0bae\u0bbe\u0ba9 \u0baa\u0bbe\u0b95\u0bcd\u0b95\u0ba3\u0bae\u0bcd"}, {"s": 159.9, "e": 162.28, "text": "\u0b8e\u0bb2\u0bcd\u0bb2\u0bbe\u0bb5\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd \u0b95\u0bb2\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1\u0bb0\u0bc1\u0b99\u0bcd\u0b95"}, {"s": 164.66, "e": 166.66, "text": "1 \u0ba8\u0bbf\u0bae\u0bbf\u0bb7\u0bae\u0bcd \u0ba9\u0bc1\u0bae\u0bcd\u0bae \u0bb5\u0bc7\u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd"}, {"s": 168.74, "e": 171.36, "text": "\u0b95\u0b9f\u0bc8\u0b9a\u0bbf\u0baf\u0bbe \u0b87\u0ba4\u0bc1\u0bb2 \u0b95\u0bca\u0b9e\u0bcd\u0b9a\u0bae\u0bcd \u0bae\u0bbf\u0bb2\u0bc8\u0b9a\u0bc1"}, {"s": 172.12, "e": 174.42, "text": "\u0b85\u0baa\u0bcd\u0baa\u0bb1\u0bcd\u0bb1\u0bae\u0bbe \u0b95\u0bca\u0b9e\u0bcd\u0b9a\u0bc1 \u0ba8\u0bb1\u0bcd\u0bb1\u0bbf\u0ba9 \u0bae\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0bb2\u0bc8"}, {"s": 205.84, "e": 208.36, "text": "\u0ba8\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0b9a\u0bc1\u0bb5\u0bc8\u0baf\u0bb0\u0bcd \u0bae\u0bc1\u0b95\u0bb2\u0bcd \u0bae\u0bb2\u0bb0\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd"}]}}