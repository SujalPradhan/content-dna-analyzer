e": 223.18}, {"w": "Circular", "s": 223.82, "e": 223.96}, {"w": "and", "s": 223.96, "e": 224.4}, {"w": "oscillatory", "s": 224.4, "e": 225.1}, {"w": "motions", "s": 225.1, "e": 225.5}, {"w": "are", "s": 225.5, "e": 225.9}, {"w": "examples", "s": 225.9, "e": 226.32}, {"w": "of", "s": 226.32, "e": 227.28}, {"w": "periodic", "s": 227.28, "e": 227.28}, {"w": "motion", "s": 227.28, "e": 227.72}, {"w": "Today", "s": 228.28, "e": 229.0}, {"w": "we", "s": 229.0, "e": 229.28}, {"w": "learned", "s": 229.28, "e": 229.54}, {"w": "how", "s": 229.54, "e": 229.72}, {"w": "to", "s": 229.72, "e": 230.22}, {"w": "measure", "s": 230.22, "e": 230.22}, {"w": "accurately", "s": 230.22, "e": 230.92}, {"w": "choose", "s": 231.76, "e": 231.78}, {"w": "the", "s": 231.78, "e": 232.1}, {"w": "correct", "s": 232.1, "e": 232.34}, {"w": "units", "s": 232.34, "e": 232.8}, {"w": "describe", "s": 233.82, "e": 234.1}, {"w": "position", "s": 234.1, "e": 234.58}, {"w": "using", "s": 234.58, "e": 234.88}, {"w": "a", "s": 234.88, "e": 235.38}, {"w": "reference", "s": 235.38, "e": 235.38}, {"w": "point", "s": 235.38, "e": 235.84}, {"w": "Thank", "s": 237.8, "e": 238.52}, {"w": "you", "s": 238.52, "e": 238.64}, {"w": "for", "s": 238.64, "e": 238.94}, {"w": "watching", "s": 238.94, "e": 239.22}, {"w": "Please", "s": 239.58, "e": 239.64}, {"w": "subscribe", "s": 239.64, "e": 240.28}, {"w": "like", "s": 240.42, "e": 240.74}, {"w": "and", "s": 240.74, "e": 240.98}, {"w": "share", "s": 240.98, "e": 241.28}, {"w": "Keep", "s": 242.34, "e": 242.6}, {"w": "learning", "s": 242.6, "e": 242.98}, {"w": "See", "s": 243.86, "e": 244.38}, {"w": "you", "s": 244.38, "e": 244.5}, {"w": "in", "s": 244.5, "e": 244.74}, {"w": "the", "s": 244.74, "e": 245.04}, {"w": "next", "s": 245.04, "e": 245.22}, {"w": "video", "s": 245.22, "e": 245.56}], "segments": [{"s": 0.0, "e": 2.62, "text": "Mother, I need cloth for my new school uniform."}, {"s": 2.84, "e": 4.54, "text": "Please give us 2 meters of this blue cloth."}, {"s": 4.8, "e": 6.28, "text": "Certainly, I'll measure it accurately."}, {"s": 6.5, "e": 7.82, "text": "I'll use this metal measuring rod."}, {"s": 8.0, "e": 9.94, "text": "Different jobs need different measuring tools."}, {"s": 10.44, "e": 11.8, "text": "Stand still, I'll take your measurements."}, {"s": 12.34, "e": 14.72, "text": "Please make the uniform 4 fingers wider in length."}, {"s": 14.84, "e": 15.2, "text": "Charangula."}, {"s": 15.46, "e": 16.5, "text": "What does Charangula mean?"}, {"s": 16.66, "e": 18.7, "text": "Charangula means 4 finger widths."}, {"s": 18.7, "e": 19.9, "text": "An ancient way of measuring."}, {"s": 20.12, "e": 21.36, "text": "Using your hand span."}, {"s": 21.66, "e": 23.16, "text": "I got 6 hand spans."}, {"s": 23.44, "e": 24.56, "text": "Mine is only 5."}, {"s": 24.62, "e": 25.8, "text": "I counted 7."}, {"s": 26.16, "e": 28.0, "text": "Because everyone's hands are different,"}, {"s": 28.04, "e": 29.46, "text": "the measurements are different too."}, {"s": 30.16, "e": 33.44, "text": "Hand span, foot and finger widths vary from person to person."}, {"s": 33.74, "e": 35.3, "text": "That's why our answers are different."}, {"s": 35.7, "e": 36.08, "text": "Exactly."}, {"s": 36.36, "e": 38.42, "text": "Standard units so everyone gets the same measurement."}, {"s": 38.7, "e": 40.16, "text": "Standard units make measurements fair."}, {"s": 40.32, "e": 43.58, "text": "India has used measurement systems for thousands of years."}, {"s": 44.58, "e": 47.32, "text": "Ancient units included Angula, Dhanusa and Yojana."}, {"s": 47.86, "e": 51.74, "text": "Even today, some traditional carpenters and tailors still use Angula."}, {"s": 51.96, "e": 54.36, "text": "People once used many different measurement systems."}, {"s": 54.36, "e": 59.24, "text": "To avoid confusion, countries adopted the international system of units called SI."}, {"s": 59.74, "e": 61.98, "text": "The SI unit of length is the meter."}, {"s": 62.1, "e": 64.8, "text": "1 meter equals 100 centimeters."}, {"s": 65.54, "e": 67.62, "text": "Each centimeter has 10 millimeters."}, {"s": 68.66, "e": 71.5, "text": "Millimeter is the smallest division on an ordinary ruler."}, {"s": 72.3, "e": 73.76, "text": "Large distances use kilometers."}, {"s": 74.2, "e": 75.66, "text": "Everyday objects use meters."}, {"s": 75.96, "e": 77.5, "text": "Small objects use centimeters."}, {"s": 77.74, "e": 79.56, "text": "Very tiny thicknesses use millimeters."}, {"s": 79.96, "e": 81.62, "text": "Always choose the most suitable unit."}, {"s": 82.12, "e": 83.6, "text": "Remember these important conversions."}, {"s": 83.6, "e": 86.52, "text": "1 kilometer equals 1000 meters."}, {"s": 86.86, "e": 88.9, "text": "1 meter equals 100 centimeters."}, {"s": 89.38, "e": 91.96, "text": "1 centimeter equals 10 millimeters."}, {"s": 92.56, "e": 94.08, "text": "Some rulers also show inches."}, {"s": 94.72, "e": 96.86, "text": "1 inch equals 2.54 centimeters."}, {"s": 97.38, "e": 99.12, "text": "Although SI units are standard today,"}, {"s": 99.6, "e": 102.08, "text": "inches and feet are still used by many people."}, {"s": 102.32, "e": 104.88, "text": "Always place the scale along the object's length."}, {"s": 107.44, "e": 109.6, "text": "Proper placement gives accurate measurements."}, {"s": 112.18, "e": 115.62, "text": "Keep your eye directly above the reading."}, {"s": 117.64, "e": 119.52, "text": "This avoids parallax error."}, {"s": 120.04, "e": 121.78, "text": "Even a broken scale can be used."}, {"s": 122.36, "e": 123.56, "text": "Start from another clear mark."}, {"s": 124.36, "e": 126.22, "text": "Subtract the starting reading from the ending reading."}, {"s": 126.62, "e": 129.66, "text": "Here, 10.4, 9.4 centimeters."}, {"s": 130.34, "e": 133.78, "text": "Students with visual impairment use rulers with raised markings."}, {"s": 134.8, "e": 137.52, "text": "Science should be accessible to everyone."}, {"s": 137.52, "e": 140.44, "text": "Always leave a space between the number and unit."}, {"s": 141.06, "e": 145.66, "text": "And write symbols like kilometers, m, c meters and mm in lowercase."}, {"s": 146.36, "e": 149.12, "text": "Curved lines can be measured using thread."}, {"s": 150.68, "e": 153.46, "text": "Now we can measure any curve."}, {"s": 153.96, "e": 155.34, "text": "The school is closer."}, {"s": 155.64, "e": 157.34, "text": "No, the garden is closer."}, {"s": 157.98, "e": 161.58, "text": "Everyone is correct because each is measuring from a different place."}, {"s": 161.78, "e": 164.28, "text": "When everyone measures from the same point,"}, {"s": 164.68, "e": 166.1, "text": "the answers become the same."}, {"s": 166.1, "e": 169.54, "text": "That fixed place is called the reference point."}, {"s": 170.16, "e": 172.32, "text": "Let's choose our reference point first."}, {"s": 173.18, "e": 175.66, "text": "Now we can measure every line correctly."}, {"s": 178.04, "e": 180.84, "text": "Look, we're getting closer to Delhi."}, {"s": 181.9, "e": 183.1, "text": "Delhi is the reference point."}, {"s": 185.52, "e": 187.46, "text": "The passengers look still."}, {"s": 188.66, "e": 190.3, "text": "Inside the bus, they are at rest."}, {"s": 191.14, "e": 193.46, "text": "Compared to the road outside, they are moving."}, {"s": 195.04, "e": 198.38, "text": "Motion in a straight line is called linear motion."}, {"s": 199.2, "e": 201.86, "text": "Notice the applied force leads to a straight path."}, {"s": 205.14, "e": 209.66, "text": "Motion along a circular path is called circular motion."}, {"s": 213.22, "e": 217.42, "text": "To and fro motion about a fixed position is oscillatory motion."}, {"s": 217.94, "e": 221.06, "text": "When motion repeats after equal intervals of time,"}, {"s": 221.06, "e": 223.18, "text": "it is called periodic motion."}, {"s": 223.82, "e": 227.72, "text": "Circular and oscillatory motions are examples of periodic motion."}, {"s": 228.28, "e": 230.92, "text": "Today we learned how to measure accurately,"}, {"s": 231.76, "e": 232.8, "text": "choose the correct units,"}, {"s": 233.82, "e": 235.84, "text": "describe position using a reference point."}, {"s": 237.8, "e": 239.22, "text": "Thank you for watching."}, {"s": 239.58, "e": 241.28, "text": "Please subscribe, like and share."}, {"s": 242.34, "e": 242.98, "text": "Keep learning."}, {"s": 243.86, "e": 245.56, "text": "See you in the next video."}]}}